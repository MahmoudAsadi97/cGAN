    "source": "\"\"\"One saved BCE96 seed: artifact compatibility, not model evaluation.\"\"\"\nimport builtins\nimport io\nimport json\nfrom pathlib import Path\nimport sys\nimport traceback\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / \"scripts\"))\nimport collect_reference_study as c\n\noutput = ROOT / \"reports/reference_collector_actual_binding_check.json\"\nif output.exists():\n    raise FileExistsError(\"retain prior receipts; do not overwrite\")\nprepared96, prepared24 = ROOT / \"data/curated96\", ROOT / \"data/curated24\"\ndirectory = ROOT / \"runs/curated_reference_bce96/seed_11\"\ninputs = c.Inputs(ROOT, prepared96, prepared24)\nallowed_map = (directory / \"calibration.npz\").resolve()\nforbidden = {str((parent / name).resolve()) for parent in (prepared96, prepared24)\n             for name in (\"train.npz\", \"val.npz\", \"test.npz\")}\nattempted_profile_opens = []\nopened_paths = set()\noriginal_open, original_io_open = builtins.open, io.open\n\n\ndef guard(function):\n    def opened(file, *args, **kwargs):\n        if isinstance(file, (str, bytes, Path)):\n            path = Path(file).resolve()\n            if str(path) in forbidden or (path.suffix == \".npz\" and path != allowed_map):\n                attempted_profile_opens.append(str(path))\n                raise AssertionError(\"profile/TEST archive opening forbidden\")\n            opened_paths.add(str(path))\n        return function(file, *args, **kwargs)\n    return opened\n\n\nreceipt = {\n    \"schema_version\": 1, \"kind\": \"reference_collector_saved_artifact_compatibility_check\",\n    \"status\": \"running\", \"split\": \"val\", \"test_used\": False,\n    \"arm\": \"bce96\", \"training_seed\": 11, \"complete_study\": False,\n    \"scope\": \"Partial single-seed saved-artifact consistency only; no profile arrays, inference, fitting, metric rerun, capacity endpoint inspection or TEST access.\",\n    \"covered\": [\"prepared JSON lineage\", \"completed BCE96 training run\", \"saved-map scalar metadata\",\n                \"original raw primary\", \"native primary calibration\", \"native primary utility\"],\n    \"not_covered\": [\"other seeds and arms\", \"precision-cap reports\", \"common-hourly reports\", \"paired reports\", \"complete-study collection\"],\n    \"checks_passed\": [],\n}\nsources = [ROOT / \"scripts/collect_reference_study.py\", ROOT / \"scripts/collect_calibrated_study.py\",\n           ROOT / \"scripts/compare_reference_uncertainty.py\", ROOT / \"scripts/compare_resolutions.py\",\n           ROOT / \"scripts/evaluate_unconditional_reference.py\", *sorted((ROOT / \"src/fluvius_cgan\").glob(\"*.py\"))]\ntry:\n    builtins.open, io.open = guard(original_open), guard(original_io_open)\n    receipt[\"collector_sources_sha256\"] = {str(path.relative_to(ROOT)): inputs.record(path)[\"sha256\"] for path in sources}\n    receipt[\"inspection_script\"] = {\"sha256\": c.sha256_file(__file__), \"source\": Path(__file__).read_text()}\n    prep = c.preparation(inputs)\n    receipt[\"checks_passed\"].append(\"prepared metadata/manifests bind native and derived lineage\")\n    run = c.training_run(inputs, directory, \"bce96\", 11, \"swd10\", prep)\n    receipt[\"checks_passed\"].append(\"complete26epochs30784updates, config/history/best/last/source/scaler/data consistent\")\n    saved_map = c.map_metadata(inputs, run)\n    receipt[\"checks_passed\"].append(\"saved map metadata binds exact checkpoint and full TRAIN protocol\")\n    raw = inputs.json(directory / \"validation_report.json\")\n    c.raw_primary(raw, run)\n    receipt[\"checks_passed\"].append(\"original raw primary binds checkpoint, data, cap100 and all64 conditions\")\n    primary = inputs.json(directory / \"calibration_validation.json\")\n    groups = {}\n    c.bind_evaluator(groups, primary, \"native_physical96\")\n    frozen = c.native_physical(primary, run, 100, saved_map)\n    c.check(c._same(raw[\"methods\"][\"cgan\"], primary[\"methods\"][\"raw_cgan\"]) and\n            c._same(raw[\"methods\"][\"conditional_resampling\"], primary[\"methods\"][\"conditional_resampling\"]),\n            \"original and calibrated-report raw endpoints differ\")\n    receipt[\"checks_passed\"].append(\"native primary physical/joint/battery/map/source and original raw agreement\")\n    utility = inputs.json(directory / \"utility_validation.json\")\n    c.bind_evaluator(groups, utility, \"native_utility96\")\n    disclosure = c.native_utility(utility, run, 100, frozen, saved_map)\n    for method in utility[\"training\"]:\n        c.fit_signature(utility, method)\n    receipt[\"checks_passed\"].append(\"native primary utility full TRAIN fits/labels/coefficients, fixed rows/map/task/source\")\n    inputs.finish()\n    receipt[\"checks_passed\"].append(\"all bound input/source fingerprints unchanged at completion\")\n    receipt[\"checkpoint_sha256\"] = run[\"checkpoint_sha256\"]\n    receipt[\"saved_map_sha256\"] = saved_map[\"sha256\"]\n    receipt[\"training_source_commit\"] = run[\"provenance\"][\"git_commit\"]\n    receipt[\"evaluator_source_groups\"] = groups\n    receipt[\"utility_reference_disclosure\"] = disclosure\n    receipt[\"status\"] = \"passed_partial_compatibility\"\nexcept Exception as error:\n    receipt[\"status\"] = \"failed_partial_compatibility\"\n    receipt[\"failure\"] = {\"type\": type(error).__name__, \"message\": str(error), \"traceback\": traceback.format_exc()}\nfinally:\n    builtins.open, io.open = original_open, original_io_open\n    receipt[\"artifacts\"] = inputs.records\n    receipt[\"profile_or_test_open_attempts\"] = attempted_profile_opens\n    receipt[\"opened_paths\"] = sorted(opened_paths)\n    output.parent.mkdir(parents=True, exist_ok=True)\n    with output.open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump(receipt, stream, indent=2, sort_keys=True, allow_nan=False)\n        stream.write(\"\\n\")\nprint(receipt[\"status\"], output)\nif \"failure\" in receipt:\n    print(receipt[\"failure\"][\"message\"])\n    raise SystemExit(1)\n"
  },
